# Copy this file to `.env` in this same `deploy/` directory (next to
# docker-compose.yml) and fill in real values.
# `.env` is git-ignored - never commit real secrets.
#
#   cp .env.example .env

# --- Database (Postgres container + backend connection string) -------------
# POSTGRES_PASSWORD must match the password the existing postgres_data volume
# was created with. Keep the existing value until you do a planned migration.
POSTGRES_USER=eepy_admin
POSTGRES_PASSWORD=SET_ME_existing_value_in_your_old_env_file
POSTGRES_DB=eepy_host
# Use the <password> above in this URL (host "db" resolves to the db container)
DATABASE_URL=postgresql://eepy_admin:SET_ME@db:5432/eepy_host

# --- Backend (FastAPI) -------------------------------------------------------
# Long random string that signs JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotating this signs everyone out (harmless re-login).
SECRET_KEY=SET_ME_long_random_string

# 44-char url-safe Base64 Fernet key. Generate a NEW one only if you do NOT
# need to keep already-stored integration credentials readable:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you already have a working instance, ask the maintainers for the matching
# key (or migrate credentials) before changing this.
MCP_ENCRYPTION_KEY=SET_ME_valid_fernet_key

# --- Frontend (Next.js) -------------------------------------------------------
# NOTE: baked into the image at build time; the runtime container value is
# informational only.
NEXT_PUBLIC_API_URL=https://api.eepy.host
