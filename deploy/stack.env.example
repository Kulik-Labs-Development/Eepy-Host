# Copy this file to `stack.env` in this same `deploy/` directory (next to
# docker-compose.yml) and fill in real values.
# `stack.env` is git-ignored - never commit real secrets.
#
#   cp stack.env.example stack.env
#
# Naming note: this file is called `stack.env` (not `.env`) because the stack is
# normally deployed through Portainer - a plain `.env` invites accidental
# `docker compose`/dotfile tooling confusion on shared hosts.

# --- Database (Postgres container + backend connection string) -------------
# POSTGRES_PASSWORD must match the password the existing postgres_data volume
# was created with. Keep the existing value until you do a planned migration.
POSTGRES_USER=eepy_admin
POSTGRES_PASSWORD=SET_ME_existing_value_in_your_old_env_file
POSTGRES_DB=eepy_host
# Use the <password> above in this URL (host "db" resolves to the db container)
DATABASE_URL=postgresql://eepy_admin:SET_ME@db:5432/eepy_host
#
# DATA PERSISTENCE (read before any redeploy): users, saved integration
# credentials, and tool API keys live in the named volume `postgres_data`
# (Portainer prefixes it with the stack name: <stackname>_postgres_data).
# A redeploy of the SAME stack keeps it. If you DELETE and re-add the stack
# (or re-import it under a different name), a NEW empty volume is created and
# all data is gone - there is no code fix for that; the volume must be
# carried over (Portainer: move/copy the volume, or dump+restore with
# pg_dump/pg_restore before recreating). After every redeploy, the Debug Log
# console prints a "Boot data summary: users=N mcp_configs=M ..." line -
# zeros there mean the volume was not carried over.

# --- Backend (FastAPI) -------------------------------------------------------
# Long random string that signs JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Rotating this signs everyone out (harmless re-login).
SECRET_KEY=SET_ME_long_random_string

# 44-char url-safe Base64 Fernet key. Generate a NEW one only if you do NOT
# need to keep already-stored integration credentials readable:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you already have a working instance, ask the maintainers for the matching
# key (or migrate credentials) before changing this.
MCP_ENCRYPTION_KEY=SET_ME_valid_fernet_key

# Initial admin account: the user with this username is promoted to superuser
# at boot and on login (idempotent). You need a superuser for the Debug Log
# console and the Organization tools. Set it to your own username.
SUPERUSER_USERNAME=SET_ME_your_username

# --- Modular MCP sidecar runtime ---------------------------------------------
# How the backend runs integration MCP servers (templates with
# runtime=mcp-server). "docker" runs each integration's sidecar image
# (built by CI from the integrations/ git submodules) as a per-user sidecar
# container (default in docker-compose.yml; requires the Docker socket,
# which the compose file mounts on the backend service). "subprocess" spawns
# the integration as a local process inside the backend container instead
# (local dev with the integrations/ submodule checked out).
EEPY_MCP_INSTANCE_BACKEND=docker
# Sidecars attach to the compose-defined `eepy-sidecars` docker network and
# are dialed directly by container IP (no host port published; the sidecar is
# unreachable from the host/LAN). Set automatically by docker-compose.yml -
# leave out of stack.env unless you have a non-standard setup.
# EEPY_MCP_SIDECAR_NETWORK=eepy-sidecars
# Fallback dial address for the legacy loopback-publish mode (only used when
# EEPY_MCP_SIDECAR_NETWORK is removed from the compose file).
# EEPY_MCP_DOCKER_HOST=host.docker.internal

# Optional CORS origin pinning (browser clients, e.g. Open WebUI, call the API
# from their own origin). Leave unset (default): all origins allowed — safe
# because auth is Bearer-token only, no cookie sessions. Set a comma-separated
# list (e.g. https://ai.example.com) to restrict preflights to exact origins.
# CORS_ORIGINS=

# Optional sidecar containment. A sidecar runs third-party code holding a
# user's decrypted credentials in its env, so it runs with CPU/memory caps.
# Uncomment to tune (values shown are the defaults).
# EEPY_MCP_SIDECAR_MEM_LIMIT=512m
# EEPY_MCP_SIDECAR_CPU_LIMIT=1.0
#
# Optional unique id per backend process, used by the sidecar orphan sweep to
# tell "my leftover" from "a sibling replica's live sidecar". Leave unset
# (default): each process self-identifies with a uuid. Only set it if your
# orchestrator already guarantees a unique id per backend process.
# EEPY_NODE_ID=

# --- Frontend (Next.js) -------------------------------------------------------
# NOTE: baked into the image at build time; the runtime container value is
# informational only.
NEXT_PUBLIC_API_URL=https://api.eepy.host
