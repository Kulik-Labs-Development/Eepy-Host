# Docker build context is the repo root (backend + integration sidecar images).
# Keep only what the images need.
.git
.github
assets
frontend
# The sidecar images copy only their own submodule (integrations/<name>/*) and
# the backend image copies only backend/* — so nothing else from integrations/
# is needed, but the submodules' .git metadata should never be sent.
integrations/happyfox-mcp/.git
integrations/ebay-mcp/.git
__pycache__
*.pyc
.venv
venv
node_modules
*.db
*.sqlite
deploy/stack.env
.env
