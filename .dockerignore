# Docker build context is the repo root (backend + integration sidecar images).
# Keep only what the images need.
.git
.github
assets
frontend
# The sidecar images copy only their own submodule (integrations/<name>/*) and
# the backend image copies only backend/* — so nothing else from integrations/
# is needed, but the submodules' .git metadata should never be sent.
integrations/happyfox-mcp/.git
integrations/ebay-mcp/.git
integrations/portainer-mcp/.git
integrations/warden-mcp/.git
# portainer-mcp dev-only trees (not copied by Dockerfile.portainer, but
# never sent in the build context either)
integrations/portainer-mcp/docs
integrations/portainer-mcp/tests
integrations/portainer-mcp/spec
integrations/portainer-mcp/.claude
# warden-mcp dev-only trees (Dockerfile.warden builds dist/ from src in-image)
integrations/warden-mcp/dist
__pycache__
*.pyc
.venv
venv
node_modules
*.db
*.sqlite
deploy/stack.env
.env
